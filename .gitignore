# Ignore Python cache files in the main folder and SafePrint folder
/main/__pycache__/
/main/migrations/__pycache__/
/SafePrint/__pycache__/

# Ignore compiled Python files
*.pyc
*.pyo

# Ignore virtual environment folders
venv/
env/

# Ignore IDE-specific files
.vscode/
.idea/
.github/

# Ignore upload directories
/media/

# Ignore database files
*.sqlite3

# Ignore environment files
.env
*firebase-adminsdk*.json

# Ignore pyc files in the main folder and SafePrint folders
/main/*.pyc
/SafePrint/*.pyc

# Ignore everything in logs except the folder itself
/logs/*
!/logs/